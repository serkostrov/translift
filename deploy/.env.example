# Настройки «Транслифт» на сервере. Скопируйте в deploy/.env и заполните.
# Пароли — длинные случайные строки, например: openssl rand -base64 24

# Домен, по которому открывается приложение (DNS-запись A должна указывать на сервер).
# Caddy сам выпустит и будет продлевать сертификат HTTPS.
DOMAIN=lift.example.ru
PUBLIC_URL=https://lift.example.ru
# Почта для уведомлений Let's Encrypt о сертификате
ACME_EMAIL=admin@example.ru

# База данных
POSTGRES_PASSWORD=

# Хранилище файлов (SeaweedFS по протоколу S3, наружу не открыто)
S3_ACCESS_KEY=translift
S3_SECRET_KEY=

# Название подрядчика в шапке отчёта генподрядчику
COMPANY_NAME=Транслифт Иваново
APP_TIMEZONE=Europe/Moscow

# Первый администратор — создаётся командой seed (см. docs/DEPLOY.md).
# После первого входа смените пароль в профиле и удалите строку пароля отсюда.
SEED_ADMIN_EMAIL=admin@user.ru
SEED_ADMIN_PASSWORD=

# Описание API на /api/docs — включайте только на время отладки
SWAGGER=false

# Сколько дней хранить резервные копии (deploy/backup.sh)
BACKUP_KEEP_DAYS=14
