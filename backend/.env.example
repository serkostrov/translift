API_PORT=3000
# Разрешённый origin фронтенда (CORS)
FRONTEND_ORIGIN=http://localhost:5174

DATABASE_URL=postgresql://translift:translift@localhost:5433/translift?schema=public

S3_ENDPOINT=http://localhost:9101
S3_REGION=us-east-1
S3_BUCKET=translift
S3_ACCESS_KEY=translift
S3_SECRET_KEY=translift-secret
S3_FORCE_PATH_STYLE=true

# Первый администратор для локальной разработки (pnpm db:seed)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=translift-local
